# Set these in Vercel → Project → Settings → Environment Variables.

# Storage: added automatically when you connect "Upstash for Redis" under Vercel → Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Password for the team guest list at /guests/
GUESTLIST_PASSWORD=

# Email notification on every RSVP (via resend.com, free plan is enough)
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=HIDUP Events <events@bali-hidup-agency.com>
NOTIFY_EMAIL_TO=info@bali-hidup-agency.com

# Optional: any webhook (Slack, Make, Zapier ...) that should receive each RSVP as JSON
NOTIFY_WEBHOOK_URL=
